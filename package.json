{
  "name": "ai-moodboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node build.mjs --dev",
    "build": "npm run typecheck && npm run build:css && npm run build:js",
    "build:js": "node build.mjs",
    "build:css": "postcss src/styles/app.css -o dist/gw-moodboard.css",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src build.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cssnano": "^8.0.10",
    "esbuild": "^0.28.2",
    "oxlint": "^1.69.0",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.0",
    "postcss-prefix-selector": "^2.2.1",
    "typescript": "~5.9.2"
  }
}
